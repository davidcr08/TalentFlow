# Variables de entorno (plantilla). Copie este archivo a `.env`:
#   cp .env.example .env
# Docker Compose lo lee solo. Todos los valores son OPCIONALES: si falta uno, el
# docker-compose.yml usa el mismo valor por defecto que aparece aquí.
# Los secretos reales NO se versionan (.env está en .gitignore).

# --- Broker (RabbitMQ) ---
RABBITMQ_USER=talentflow
RABBITMQ_PASS=talentflow_dev

# --- Base de datos: empleados (PostgreSQL) ---
DB_EMPLEADOS_NAME=db_empleados
DB_EMPLEADOS_USER=user_empleados
DB_EMPLEADOS_PASS=pass_empleados

# --- Base de datos: departamentos (MySQL) ---
DB_DEPTO_NAME=db_deptos
DB_DEPTO_USER=user_deptos
DB_DEPTO_PASS=pass_deptos
DB_DEPTO_ROOT_PASS=root_pass

# --- Base de datos: perfiles (PostgreSQL) ---
DB_PERFILES_NAME=db_perfiles
DB_PERFILES_USER=user_perfiles
DB_PERFILES_PASS=pass_perfiles

# --- Base de datos: notificaciones (PostgreSQL) ---
DB_NOTIF_NAME=db_notificaciones
DB_NOTIF_USER=user_notificaciones
DB_NOTIF_PASS=pass_notificaciones

# --- Base de datos: vacaciones (PostgreSQL) ---
DB_VACACIONES_NAME=db_vacaciones
DB_VACACIONES_USER=user_vacaciones
DB_VACACIONES_PASS=pass_vacaciones

# --- Autenticación (JWT) ---
# JWT_SECRET: mínimo 32 caracteres. CAMBIARLO fuera de desarrollo.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_EXPIRA_SEGUNDOS=3600
# ADMIN semilla (su "sub" en el JWT es ADMIN_ID)
ADMIN_ID=ADMIN
ADMIN_EMAIL=admin@talentflow.local
ADMIN_PASSWORD=admin_dev_change_me
